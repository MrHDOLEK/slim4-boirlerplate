{
    "name": "mrhdolek/slim4-boirlerplate",
    "description": "An Slim 4 Framework skeleton using AMQP,DDD,Doctrine",
    "keywords": [
        "microframework",
        "rest",
        "router",
        "psr7",
        "ddd",
        "amqp",
        "doctrine"
    ],
    "homepage": "https://github.com/MrHDOLEK/slim4-boirlerplat",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksander Kowalski",
            "email": "mrhdolek14@gmail.com",
            "homepage": "https://github.com/MrHDOLEK"
        },
        {
            "name": "Kamil Piech",
            "homepage": "https://github.com/kamilpiech97"
        },
        {
            "name": "Robiningel Brecht",
            "homepage": "https://github.com/robiningelbrecht"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-rdkafka": "^6.0",
        "ext-sockets": "*",
        "awurth/slim-validation": "^5.1",
        "doctrine/data-fixtures": "^2.2",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "fakerphp/faker": "^1.24",
        "firehed/dbal-logger": "^3.0",
        "flix-tech/avro-serde-php": "^3.0",
        "laminas/laminas-diactoros": "^3.8",
        "lcobucci/clock": "^3.6",
        "monolog/monolog": "^3.12",
        "peppeocchi/php-cron-scheduler": "^4.0",
        "php-amqplib/php-amqplib": "^3.7",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "predis/predis": "^3.6",
        "ramsey/uuid": "^4.9",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15.3",
        "slim/twig-view": "^3.4",
        "symfony/cache": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/serializer-pack": "^1.4",
        "symfony/yaml": "^8.1",
        "thecodingmachine/safe": "^3.4",
        "vlucas/phpdotenv": "^5.7",
        "zircote/swagger-php": "^6.8"
    },
    "require-dev": {
        "kwn/php-rdkafka-stubs": "^3.0",
        "league/openapi-psr7-validator": "^0.24.0",
        "phpunit/phpunit": "^13.3",
        "spatie/phpunit-snapshot-assertions": "^5.4"
    },
    "config": {
        "allow-plugins": false,
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "fixtures\\": "fixtures/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 tools/cs-fixer/vendor/bin/php-cs-fixer fix --diff --config codestyle.php",
        "cs:check": "PHP_CS_FIXER_IGNORE_ENV=1 tools/cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff --config codestyle.php",
        "phpstan": [
            "php -d memory_limit=600M tools/phpstan/vendor/bin/phpstan analyse -c phpstan.neon"
        ],
        "tools:install": [
            "@composer install --working-dir=tools/phpstan",
            "@composer install --working-dir=tools/cs-fixer",
            "@composer install --working-dir=tools/deptrac"
        ],
        "tools:update": [
            "@composer update --working-dir=tools/phpstan",
            "@composer update --working-dir=tools/cs-fixer",
            "@composer update --working-dir=tools/deptrac"
        ],
        "test": "phpunit",
        "test:architecture": "tools/deptrac/vendor/bin/deptrac --config-file=deptrac.yaml --formatter=table",
        "snapshots:cleanup": "find . -name __snapshots__ -type d -prune -exec rm -rf {} \\; ",
        "migrate": "php vendor/bin/doctrine-migrations migrate",
        "db:seed": "php bin/console.php db:seed",
        "openapi": "php vendor/bin/openapi /var/www/src --output resources/docs/openapi.yaml",
        "post-create-project-cmd": [
            "cp ./.env.dist ./.env"
        ]
    }
}
