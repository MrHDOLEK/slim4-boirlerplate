APP_NAME=slim

ENVIRONMENT=dev

DISPLAY_ERROR_DETAILS=0
LOG_ERRORS=0
LOG_ERROR_DETAILS=0

DB_HOST=db
DB_PORT=5432
DB_NAME=dbname
DB_USER=user
DB_PASSWORD=passwd

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_DEFAULT_DB=0

EVENT_BROKER=amqp

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASS=rabbitmq
RABBITMQ_VHOST=app
DOCKER_TARGET_APP=fpm
DOCTRINE_CACHE_TTL=3600
SLOW_QUERY_THRESHOLD=3600
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=slim4-app
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_AUTO_OFFSET_RESET=earliest
